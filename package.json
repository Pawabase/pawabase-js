{
  "name": "@pawabase/client",
  "version": "0.1.0",
  "description": "Official TypeScript client for Pawabase: data, auth, storage, functions, flows and realtime.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./manage": {
      "import": {
        "types": "./dist/esm/manage/index.d.ts",
        "default": "./dist/esm/manage/index.js"
      },
      "require": {
        "types": "./dist/cjs/manage/index.d.ts",
        "default": "./dist/cjs/manage/index.js"
      }
    },
    "./admin": {
      "import": {
        "types": "./dist/esm/admin.d.ts",
        "default": "./dist/esm/admin.js"
      },
      "require": {
        "types": "./dist/cjs/admin.d.ts",
        "default": "./dist/cjs/admin.js"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "pawabase-types": "./dist/esm/cli/gen-types.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/finish-build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "rm -rf dist-test && tsc -p tsconfig.test.json && node --test --test-concurrency=1 $(find dist-test/test -name \"*.test.js\")",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "pawabase",
    "backend",
    "sdk",
    "realtime",
    "auth",
    "storage"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "typescript": "^5.6.0",
    "ws": "^8.22.0"
  },
  "typesVersions": {
    "*": {
      "manage": [
        "./dist/esm/manage/index.d.ts"
      ],
      "admin": [
        "./dist/esm/admin.d.ts"
      ]
    }
  }
}
